{
  "name": "FonteDados",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "ID \u00fanico da fonte (ex: IBGE_LOCALIDADES, SICONFI, PREFEITURA)"
    },
    "source_name": {
      "type": "string",
      "description": "Nome leg\u00edvel da fonte"
    },
    "category": {
      "type": "string",
      "description": "Categoria tem\u00e1tica associada (demografia, fiscal, resumo, telecomunicacoes, etc.)"
    },
    "method": {
      "type": "string",
      "enum": [
        "API",
        "DOWNLOAD",
        "GEOSPATIAL",
        "WEB_OFFICIAL_AI"
      ],
      "description": "M\u00e9todo de coleta: API=endpoint estruturado; DOWNLOAD=base oficial sob demanda; GEOSPATIAL=cruzamento por coordenada; WEB_OFFICIAL_AI=GPT localiza em fontes oficiais"
    },
    "cadence_days": {
      "type": "number",
      "default": 30,
      "description": "TTL de cache em dias (1=di\u00e1rio, 7=semanal, 30=mensal, 365=publica\u00e7\u00e3o)"
    },
    "auth_secret": {
      "type": "string",
      "description": "Nome da secret necess\u00e1ria (ex: PORTAL_TRANSPARENCIA_CHAVE)"
    },
    "endpoint": {
      "type": "string",
      "description": "URL/endpoint testado"
    },
    "requires_auth": {
      "type": "boolean",
      "default": false,
      "description": "Se a fonte requer autentica\u00e7\u00e3o/chave"
    },
    "status": {
      "type": "string",
      "enum": [
        "ATIVA",
        "DEGRADADA",
        "AUTH_REQUIRED",
        "NO_COVERAGE",
        "TEMP_UNAVAILABLE",
        "INVALID_SCHEMA",
        "DISCONTINUED",
        "EM_TESTE",
        "ERRO_DE_AUTENTICACAO",
        "ERRO_DE_ENDPOINT",
        "SEM_DADOS_PARA_O_MUNICIPIO",
        "RESPOSTA_INVALIDA"
      ],
      "description": "Status exposto ao usu\u00e1rio. Valores novo padr\u00e3o spec: ATIVA, DEGRADADA, AUTH_REQUIRED, NO_COVERAGE, TEMP_UNAVAILABLE, INVALID_SCHEMA, DISCONTINUED. Legado aceito: ERRO_DE_AUTENTICACAO=AUTH_REQUIRED, ERRO_DE_ENDPOINT=TEMP_UNAVAILABLE, SEM_DADOS_PARA_O_MUNICIPIO=NO_COVERAGE, RESPOSTA_INVALIDA=INVALID_SCHEMA"
    },
    "status_tecnico": {
      "type": "string",
      "description": "Status t\u00e9cnico interno do \u00faltimo teste (antes da pol\u00edtica de falhas)"
    },
    "last_test_at": {
      "type": "string",
      "format": "date-time"
    },
    "response_time_ms": {
      "type": "number"
    },
    "http_status": {
      "type": "number"
    },
    "error_message": {
      "type": "string"
    },
    "sample_municipality": {
      "type": "string"
    },
    "sample_result_count": {
      "type": "number"
    },
    "schema_valid": {
      "type": "boolean"
    },
    "data_valid": {
      "type": "boolean",
      "description": "Dados tecnicamente + coerentemente v\u00e1lidos (IA n\u00e3o sinalizou inconsist\u00eancia)"
    },
    "coherence_observacao": {
      "type": "string"
    },
    "coherence_consistente": {
      "type": "boolean"
    },
    "coherence_magnitude_ok": {
      "type": "boolean"
    },
    "consecutive_failures": {
      "type": "number",
      "default": 0,
      "description": "Falhas consecutivas \u2014 2=DEGRADADA, 3=DISCONTINUED/oculta"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "Se a fonte \u00e9 exibida em dropdowns/Chat IA"
    },
    "deactivated": {
      "type": "boolean",
      "default": false,
      "description": "Marcada como desativada ap\u00f3s 3 falhas consecutivas"
    }
  },
  "required": [
    "source_id",
    "source_name",
    "status"
  ]
}