{
  "name": "Funcao",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da fun\u00e7\u00e3o profissional"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o edit\u00e1vel da fun\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a fun\u00e7\u00e3o est\u00e1 dispon\u00edvel para sele\u00e7\u00e3o"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o na listagem"
    },
    "criado_por": {
      "type": "string",
      "description": "Email do administrador que criou a fun\u00e7\u00e3o"
    }
  },
  "required": [
    "nome"
  ]
}