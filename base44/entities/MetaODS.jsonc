{
  "name": "MetaODS",
  "type": "object",
  "properties": {
    "ods_numero": {
      "type": "number",
      "description": "N\u00famero do ODS (1-17)"
    },
    "ods_nome": {
      "type": "string",
      "description": "Nome do ODS"
    },
    "meta_descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da meta"
    },
    "meta_quantitativa": {
      "type": "number",
      "description": "Meta num\u00e9rica a ser atingida"
    },
    "valor_atual": {
      "type": "number",
      "default": 0,
      "description": "Valor atual de progresso"
    },
    "unidade_medida": {
      "type": "string",
      "description": "Unidade de medida (a\u00e7\u00f5es, benefici\u00e1rios, etc)"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo para atingir a meta"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "atingida",
        "atrasada",
        "pausada"
      ],
      "default": "em_andamento"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela meta"
    },
    "acoes_vinculadas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de registros vinculados"
    },
    "percentual_conclusao": {
      "type": "number",
      "default": 0,
      "description": "Percentual de conclus\u00e3o (0-100)"
    },
    "notas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "autor": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "progresso",
              "desafio",
              "conquista",
              "observacao"
            ]
          }
        }
      },
      "description": "Notas e coment\u00e1rios sobre a meta"
    }
  },
  "required": [
    "ods_numero",
    "ods_nome",
    "meta_descricao"
  ]
}