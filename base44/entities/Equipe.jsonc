{
  "name": "Equipe",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da equipe"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da equipe"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto de identifica\u00e7\u00e3o"
    },
    "criado_por": {
      "type": "string",
      "description": "Email do criador"
    },
    "equipe_pai_id": {
      "type": "string",
      "description": "ID da equipe pai (hierarquia)"
    },
    "nivel_hierarquia": {
      "type": "number",
      "default": 0,
      "description": "N\u00edvel na hierarquia (0=raiz)"
    },
    "caminho_hierarquia": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das equipes pai at\u00e9 raiz"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativa",
        "inativa",
        "arquivada"
      ],
      "default": "ativa"
    },
    "membros": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "administrador_equipe",
              "editor",
              "observador"
            ],
            "description": "Papel na equipe"
          },
          "data_entrada": {
            "type": "string",
            "format": "date-time"
          },
          "ultimo_acesso": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ativo",
              "inativo"
            ],
            "default": "ativo"
          }
        }
      },
      "description": "Membros da equipe"
    },
    "configuracoes": {
      "type": "object",
      "properties": {
        "permitir_auto_entrada": {
          "type": "boolean",
          "default": false,
          "description": "Permite entrada sem convite"
        },
        "visibilidade": {
          "type": "string",
          "enum": [
            "publica",
            "privada"
          ],
          "default": "privada"
        },
        "notificar_novos_membros": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "estatisticas": {
      "type": "object",
      "properties": {
        "total_registros": {
          "type": "number",
          "default": 0
        },
        "total_casos": {
          "type": "number",
          "default": 0
        },
        "ultima_atividade": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "nome",
    "criado_por"
  ]
}