{
  "name": "RevisaoTerritorio",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da revis\u00e3o de territ\u00f3rio"
    },
    "municipio": {
      "type": "string",
      "description": "Munic\u00edpio do territ\u00f3rio revisado"
    },
    "uf": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "municipality_ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio"
    },
    "comunidade": {
      "type": "string",
      "description": "Comunidade espec\u00edfica quando a revis\u00e3o \u00e9 comunit\u00e1ria"
    },
    "periodo_inicio": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo revisado"
    },
    "periodo_fim": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo revisado"
    },
    "compilacao_id": {
      "type": "string",
      "description": "ID da CompilacaoRelatorio que originou esta revis\u00e3o"
    },
    "revisor": {
      "type": "string",
      "description": "Email do respons\u00e1vel pela revis\u00e3o"
    },
    "itens_revisao": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "registro",
              "demanda",
              "devolutiva",
              "dado_secundario",
              "caso",
              "stakeholder",
              "compromisso"
            ]
          },
          "entidade_id": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "fonte": {
            "type": "string"
          },
          "status_validacao": {
            "type": "string",
            "enum": [
              "pendente",
              "validado",
              "invalidado",
              "duvidoso"
            ],
            "default": "pendente"
          },
          "observacao": {
            "type": "string"
          },
          "data_revisao": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Lista de itens revisitados (registros, demandas, devolutivas, dados secund\u00e1rios, casos, stakeholders)"
    },
    "totais": {
      "type": "object",
      "properties": {
        "total_itens": {
          "type": "number",
          "default": 0
        },
        "validados": {
          "type": "number",
          "default": 0
        },
        "invalidados": {
          "type": "number",
          "default": 0
        },
        "pendentes": {
          "type": "number",
          "default": 0
        }
      }
    },
    "pendencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "severidade": {
            "type": "string",
            "enum": [
              "baixa",
              "media",
              "alta",
              "critica"
            ],
            "default": "media"
          },
          "responsavel": {
            "type": "string"
          },
          "prazo": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "observacoes_gerais": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_revisao",
        "revisada",
        "aprovada",
        "reprovada"
      ],
      "default": "pendente"
    },
    "aprovado_para_relatorio": {
      "type": "boolean",
      "default": false
    },
    "data_revisao": {
      "type": "string",
      "format": "date-time"
    },
    "vinculado_relatorio_id": {
      "type": "string"
    }
  },
  "required": [
    "titulo"
  ]
}