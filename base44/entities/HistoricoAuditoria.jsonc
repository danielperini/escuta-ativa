{
  "name": "HistoricoAuditoria",
  "type": "object",
  "properties": {
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "LiderancaComunitaria",
        "ProjetoOrganizacao",
        "Atividade",
        "Compromisso",
        "RiscoSocial",
        "Oportunidade"
      ],
      "description": "Tipo da entidade auditada"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID da entidade modificada"
    },
    "campo_alterado": {
      "type": "string",
      "description": "Nome do campo que foi alterado"
    },
    "valor_anterior": {
      "type": "string",
      "description": "Valor antes da altera\u00e7\u00e3o"
    },
    "valor_novo": {
      "type": "string",
      "description": "Novo valor ap\u00f3s altera\u00e7\u00e3o"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "criacao",
        "atualizacao",
        "exclusao",
        "vinculacao",
        "importacao"
      ],
      "description": "Tipo de opera\u00e7\u00e3o realizada"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da altera\u00e7\u00e3o (opcional)"
    },
    "fonte_origem": {
      "type": "string",
      "description": "Origem da altera\u00e7\u00e3o (registro, importa\u00e7\u00e3o CSV, edi\u00e7\u00e3o manual, etc)"
    },
    "aprovacao_necessaria": {
      "type": "boolean",
      "default": false,
      "description": "Se a altera\u00e7\u00e3o necessitou aprova\u00e7\u00e3o humana"
    }
  },
  "required": [
    "entidade_tipo",
    "entidade_id",
    "campo_alterado",
    "usuario_responsavel"
  ]
}