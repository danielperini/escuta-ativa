{
  "name": "HistoricoAuditoria",
  "type": "object",
  "properties": {
    "entidade_tipo": {
      "type": "string",
      "enum": [
        "LiderancaComunitaria",
        "ProjetoOrganizacao",
        "Atividade",
        "Compromisso",
        "RiscoSocial",
        "Oportunidade",
        "AIChat",
        "Registro",
        "Comunidade",
        "Stakeholder",
        "Demanda",
        "DadoSecundario"
      ],
      "description": "Tipo da entidade auditada"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID da entidade modificada"
    },
    "campo_alterado": {
      "type": "string",
      "description": "Nome do campo que foi alterado"
    },
    "valor_anterior": {
      "type": "string",
      "description": "Valor antes da altera\u00e7\u00e3o"
    },
    "valor_novo": {
      "type": "string",
      "description": "Novo valor ap\u00f3s a altera\u00e7\u00e3o"
    },
    "tipo_operacao": {
      "type": "string",
      "enum": [
        "criacao",
        "atualizacao",
        "exclusao",
        "vinculacao",
        "importacao",
        "consulta_ia",
        "consulta_fonte_oficial",
        "salvamento_secondary_data"
      ],
      "description": "Tipo de opera\u00e7\u00e3o realizada"
    },
    "usuario_responsavel": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da altera\u00e7\u00e3o (opcional)"
    },
    "fonte_origem": {
      "type": "string",
      "description": "Origem da altera\u00e7\u00e3o (registro, importa\u00e7\u00e3o CSV, edi\u00e7\u00e3o manual, Chat IA, etc)"
    },
    "aprovacao_necessaria": {
      "type": "boolean",
      "default": false,
      "description": "Se a altera\u00e7\u00e3o necessitou aprova\u00e7\u00e3o humana"
    },
    "detalhes_ia": {
      "type": "object",
      "description": "Detalhes da consulta de IA (pergunta, categoria detectada, fontes consultadas, etc.)",
      "properties": {
        "pergunta": {
          "type": "string"
        },
        "municipio": {
          "type": "string"
        },
        "uf": {
          "type": "string"
        },
        "categoria_detectada": {
          "type": "string"
        },
        "consulta_interna_realizada": {
          "type": "boolean"
        },
        "consulta_docs_realizada": {
          "type": "boolean"
        },
        "consulta_dados_secundarios_realizada": {
          "type": "boolean"
        },
        "pesquisa_externa_realizada": {
          "type": "boolean"
        },
        "fonte_externa_status": {
          "type": "string"
        },
        "fontes_publicas_usadas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_atual": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "entidade_tipo",
    "entidade_id",
    "campo_alterado",
    "usuario_responsavel"
  ]
}