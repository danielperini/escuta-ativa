{
  "name": "HistoricoFuncao",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio cuja fun\u00e7\u00e3o mudou"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "funcao_anterior": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o anterior (vazio se nenhuma)"
    },
    "nova_funcao": {
      "type": "string",
      "description": "Nova fun\u00e7\u00e3o atribu\u00edda (vazio se removeu)"
    },
    "alterado_por_email": {
      "type": "string",
      "description": "Email do administrador que alterou"
    },
    "alterado_por_nome": {
      "type": "string",
      "description": "Nome do administrador que alterou"
    },
    "data": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da altera\u00e7\u00e3o"
    }
  },
  "required": [
    "usuario_email",
    "nova_funcao"
  ]
}