{
  "name": "Comunidade",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da comunidade territorial"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "bairro",
        "vila",
        "comunidade",
        "comunidade_rural",
        "distrito",
        "localidade",
        "povoado",
        "assentamento",
        "ocupacao",
        "conjunto_habitacional",
        "territorio_tradicional",
        "quilombo",
        "indigena",
        "favela",
        "outro"
      ],
      "description": "Tipo de comunidade territorial"
    },
    "municipio": {
      "type": "string",
      "description": "Munic\u00edpio onde est\u00e1 localizada"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "municipality_ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio para integra\u00e7\u00e3o com Dados Secund\u00e1rios"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o ou refer\u00eancia"
    },
    "cep": {
      "type": "string"
    },
    "populacao_estimada": {
      "type": "number"
    },
    "numero_familias": {
      "type": "number",
      "description": "N\u00famero aproximado de fam\u00edlias"
    },
    "area_urbana_rural": {
      "type": "string",
      "enum": [
        "urbana",
        "rural",
        "periurbana",
        "nao_informado"
      ],
      "default": "nao_informado"
    },
    "descricao": {
      "type": "string",
      "description": "Caracter\u00edsticas gerais, hist\u00f3rico ou observa\u00e7\u00f5es sobre a comunidade"
    },
    "localizacao": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "termometro_social": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto",
        "critico"
      ],
      "description": "N\u00edvel de tens\u00e3o social"
    },
    "principais_temas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_registros": {
      "type": "number"
    },
    "ultima_interacao": {
      "type": "string",
      "format": "date"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "municipio",
    "tipo"
  ]
}