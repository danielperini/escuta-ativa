{
  "name": "Caso",
  "type": "object",
  "properties": {
    "codigo_unico": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico autom\u00e1tico (CA-UT-XXXXXX-AAAA)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do caso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "devolutiva",
        "demanda_individual",
        "demanda_coletiva",
        "indenizacao",
        "servico",
        "apoio",
        "infraestrutura",
        "outro"
      ],
      "default": "devolutiva",
      "description": "Tipo de caso"
    },
    "stakeholders_envolvidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos stakeholders (OBRIGAT\u00d3RIO)"
    },
    "comunidade": {
      "type": "string",
      "description": "Comunidade (OBRIGAT\u00d3RIO)"
    },
    "municipio": {
      "type": "string",
      "description": "Munic\u00edpio (OBRIGAT\u00d3RIO)"
    },
    "tema": {
      "type": "string",
      "description": "Tema principal (OBRIGAT\u00d3RIO)"
    },
    "registro_origem_id": {
      "type": "string",
      "description": "ID do registro de origem"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_aberto",
        "pendente",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "em_aberto",
      "description": "Status do caso"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo para resolu\u00e7\u00e3o (padr\u00e3o 15 dias)"
    },
    "responsavel_empresa": {
      "type": "string",
      "description": "Respons\u00e1vel interno"
    },
    "historico_atualizacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "acao": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de atualiza\u00e7\u00f5es"
    },
    "evidencias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date"
          },
          "codigo_documento": {
            "type": "string",
            "description": "C\u00f3digo DOC da evid\u00eancia"
          }
        }
      }
    },
    "data_abertura": {
      "type": "string",
      "format": "date-time",
      "description": "Data de abertura autom\u00e1tica"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    },
    "necessita_aprovacao": {
      "type": "boolean",
      "default": false,
      "description": "Se precisa de aprova\u00e7\u00e3o gerencial"
    },
    "impacto_comunidade": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto",
        "critico"
      ],
      "description": "Impacto na comunidade"
    }
  },
  "required": [
    "titulo",
    "stakeholders_envolvidos",
    "comunidade",
    "municipio",
    "tema"
  ]
}