{
  "name": "RelatorioSustentabilidade",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do relat\u00f3rio"
    },
    "tipo_escopo": {
      "type": "string",
      "enum": [
        "registro_unico",
        "multiplos_registros",
        "comunidade",
        "territorio",
        "plataforma_completa"
      ],
      "description": "Escopo de gera\u00e7\u00e3o"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data inicial do per\u00edodo"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data final do per\u00edodo"
    },
    "registros_incluidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos registros inclu\u00eddos"
    },
    "casos_incluidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos casos inclu\u00eddos"
    },
    "comunidade": {
      "type": "string",
      "description": "Comunidade analisada"
    },
    "territorio": {
      "type": "string",
      "description": "Territ\u00f3rio analisado"
    },
    "total_registros": {
      "type": "number",
      "description": "Total de registros analisados"
    },
    "total_casos": {
      "type": "number",
      "description": "Total de casos analisados"
    },
    "dados_secundarios": {
      "type": "object",
      "description": "Dados Secund\u00e1rios do Territ\u00f3rio inclu\u00eddos no relat\u00f3rio (spec \u00a717): categorias, contexto territorial e indicadores por categoria. Cada indicador carrega source_name/source_url/reference_period rastre\u00e1veis (spec \u00a718, \u00a721).",
      "properties": {
        "categorias": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs das categorias selecionadas (demografia, economia, saude, ...)"
        },
        "contexto": {
          "type": "object",
          "description": "Contexto territorial (municipio, uf, ibge) identificado a partir do escopo selecionado",
          "properties": {
            "municipio": {
              "type": "string"
            },
            "uf": {
              "type": "string"
            },
            "ibge": {
              "type": "string"
            }
          }
        },
        "indicadoresPorCategoria": {
          "type": "object",
          "description": "Mapa categoria \u2192 array de DadoSecundario no momento da gera\u00e7\u00e3o (snapshot para rastreabilidade futura)"
        }
      }
    },
    "classificacoes_acoes": {
      "type": "object",
      "properties": {
        "direitos_humanos": {
          "type": "number"
        },
        "participacao_social": {
          "type": "number"
        },
        "dialogo_comunitario": {
          "type": "number"
        },
        "construcao_conjunta": {
          "type": "number"
        },
        "desenvolvimento_local": {
          "type": "number"
        },
        "governanca_social": {
          "type": "number"
        },
        "gestao_impactos": {
          "type": "number"
        },
        "cultura_identidade": {
          "type": "number"
        }
      }
    },
    "vinculacao_gri": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_ods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_pacto_global": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principio": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_esrs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "arquivo_pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "arquivo_docx_url": {
      "type": "string",
      "description": "URL do DOCX gerado"
    },
    "versao": {
      "type": "string",
      "description": "Vers\u00e3o do relat\u00f3rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "gerando",
        "concluido",
        "erro"
      ],
      "default": "gerando"
    }
  },
  "required": [
    "titulo",
    "tipo_escopo",
    "data_inicio",
    "data_fim"
  ]
}