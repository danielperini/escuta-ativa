{
  "name": "RelatorioSustentabilidade",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do relat\u00f3rio"
    },
    "tipo_escopo": {
      "type": "string",
      "enum": [
        "registro_unico",
        "multiplos_registros",
        "comunidade",
        "territorio",
        "plataforma_completa"
      ],
      "description": "Escopo de gera\u00e7\u00e3o"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data inicial do per\u00edodo"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data final do per\u00edodo"
    },
    "registros_incluidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos registros inclu\u00eddos"
    },
    "comunidade": {
      "type": "string",
      "description": "Comunidade analisada"
    },
    "territorio": {
      "type": "string",
      "description": "Territ\u00f3rio analisado"
    },
    "total_registros": {
      "type": "number",
      "description": "Total de registros analisados"
    },
    "classificacoes_acoes": {
      "type": "object",
      "properties": {
        "direitos_humanos": {
          "type": "number"
        },
        "participacao_social": {
          "type": "number"
        },
        "dialogo_comunitario": {
          "type": "number"
        },
        "construcao_conjunta": {
          "type": "number"
        },
        "desenvolvimento_local": {
          "type": "number"
        },
        "governanca_social": {
          "type": "number"
        },
        "gestao_impactos": {
          "type": "number"
        },
        "cultura_identidade": {
          "type": "number"
        }
      }
    },
    "vinculacao_gri": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_ods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number"
          },
          "nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_pacto_global": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principio": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "vinculacao_esrs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    },
    "arquivo_pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado"
    },
    "arquivo_docx_url": {
      "type": "string",
      "description": "URL do DOCX gerado"
    },
    "versao": {
      "type": "string",
      "description": "Vers\u00e3o do relat\u00f3rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "gerando",
        "concluido",
        "erro"
      ],
      "default": "gerando"
    }
  },
  "required": [
    "titulo",
    "tipo_escopo",
    "data_inicio",
    "data_fim"
  ]
}