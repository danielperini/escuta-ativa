{
  "name": "EquipeSimples",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da equipe"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da equipe"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto de identifica\u00e7\u00e3o da equipe"
    },
    "administradores": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails dos administradores"
    },
    "membros": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "papel": {
            "type": "string",
            "enum": [
              "administrador",
              "membro"
            ]
          },
          "permissoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_entrada": {
            "type": "string",
            "format": "date-time"
          },
          "ativo": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "description": "Membros da equipe"
    },
    "convites_pendentes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "papel": {
            "type": "string"
          },
          "permissoes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_convite": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "description": "Convites pendentes"
    },
    "ativa": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome"
  ]
}