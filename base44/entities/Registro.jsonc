{
  "name": "Registro",
  "type": "object",
  "properties": {
    "codigo_unico": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico autom\u00e1tico (RE-UT-XXXXXX-AAAA)"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do registro"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "reuniao",
        "conversa_campo",
        "visita",
        "demanda",
        "ocorrencia",
        "devolutiva"
      ],
      "default": "conversa_campo",
      "description": "Tipo de intera\u00e7\u00e3o. 'devolutiva' = atividade de retorno ao territ\u00f3rio que comprova a resposta a uma demanda."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o geral do registro"
    },
    "transcricao": {
      "type": "string",
      "description": "Transcri\u00e7\u00e3o completa se aplic\u00e1vel"
    },
    "equipe_id": {
      "type": "string",
      "description": "ID da equipe respons\u00e1vel"
    },
    "equipe_nome": {
      "type": "string",
      "description": "Nome da equipe"
    },
    "usuario_criador": {
      "type": "string",
      "description": "Email do criador (redundante com created_by)"
    },
    "usuario_ultima_atualizacao": {
      "type": "string",
      "description": "Email de quem atualizou por \u00faltimo"
    },
    "comunidade": {
      "type": "string",
      "description": "Comunidade territorial (bairro, vila, distrito)"
    },
    "grupo_coletivo": {
      "type": "string",
      "description": "Grupo ou coletivo envolvido (cultural, art\u00edstico, etc)"
    },
    "organizacao": {
      "type": "string",
      "description": "Organiza\u00e7\u00e3o envolvida (ONG, associa\u00e7\u00e3o, etc)"
    },
    "local": {
      "type": "string",
      "description": "Local espec\u00edfico"
    },
    "localizacao": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "endereco": {
          "type": "string"
        },
        "municipio": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        }
      },
      "description": "Coordenadas e localiza\u00e7\u00e3o completa"
    },
    "data_registro": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de participantes"
    },
    "temas_identificados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Temas discutidos"
    },
    "tipo_demanda": {
      "type": "string",
      "enum": [
        "Informa\u00e7\u00e3o",
        "Reclama\u00e7\u00e3o",
        "Solicita\u00e7\u00e3o",
        "Den\u00fancia",
        "Sugest\u00e3o",
        "Elogio",
        "Conflito",
        "N\u00e3o identificado"
      ],
      "description": "Tipo de demanda classificada"
    },
    "sentimento": {
      "type": "string",
      "enum": [
        "positivo",
        "neutro",
        "negativo",
        "misto"
      ],
      "description": "Sentimento predominante"
    },
    "temperatura_territorio": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto",
        "critico"
      ],
      "description": "N\u00edvel de tens\u00e3o social"
    },
    "indicadores_risco": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sinais de risco identificados"
    },
    "relationship_classification": {
      "type": "string",
      "enum": [
        "COMUNITARIO",
        "INSTITUCIONAL",
        "COMUNITARIO_INSTITUCIONAL"
      ],
      "description": "Classifica\u00e7\u00e3o do tipo de relacionamento da atividade. COMUNITARIO=Relacionamento Comunit\u00e1rio; INSTITUCIONAL=Relacionamento Institucional; COMUNITARIO_INSTITUCIONAL=Relacionamento Comunit\u00e1rio e Institucional. Evid\u00eancias (ata, transcri\u00e7\u00e3o, lista de presen\u00e7a, fotografia) herdam a classifica\u00e7\u00e3o do registro principal \u2014 n\u00e3o geram classifica\u00e7\u00e3o independente."
    },
    "relationship_classification_source": {
      "type": "string",
      "enum": [
        "manual",
        "ia",
        "retroativo_ia"
      ],
      "description": "Origem da classifica\u00e7\u00e3o. manual tem PRIORIDADE e nunca \u00e9 sobrescrita automaticamente pela IA; ia=classifica\u00e7\u00e3o autom\u00e1tica na cria\u00e7\u00e3o/reavalia\u00e7\u00e3o; retroativo_ia=backfill de registros antigos."
    },
    "relationship_classification_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confian\u00e7a da IA de 0 a 100. Abaixo de 70 deve ser sinalizada para revis\u00e3o humana."
    },
    "relationship_classification_reason": {
      "type": "string",
      "description": "Justificativa curta da classifica\u00e7\u00e3o (IA) ou motivo da escolha manual."
    },
    "relationship_classification_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da \u00faltima classifica\u00e7\u00e3o."
    },
    "relationship_classification_user": {
      "type": "string",
      "description": "Email do usu\u00e1rio respons\u00e1vel quando a classifica\u00e7\u00e3o \u00e9 manual."
    },
    "relationship_primary_objective": {
      "type": "string",
      "enum": [
        "ESCUTA",
        "INFORMACAO",
        "NEGOCIACAO",
        "ARTICULACAO",
        "CONSULTA",
        "MOBILIZACAO",
        "GESTAO_DE_CONFLITO",
        "ACOMPANHAMENTO",
        "DELIBERACAO",
        "PARCERIA",
        "OUTRO"
      ],
      "description": "Objetivo principal inferido da atividade. Enriquece a an\u00e1lise do relacionamento. Pode ser sugerido pela IA."
    },
    "relationship_community_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sinais comunit\u00e1rios detectados pela IA (moradores, assembleia, escuta, etc)."
    },
    "relationship_institutional_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sinais institucionais detectados pela IA (prefeitura, secretaria, MP, etc)."
    },
    "demandas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "urgencia": {
            "type": "string",
            "enum": [
              "baixa",
              "media",
              "alta",
              "critica"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "em_andamento",
              "atendida",
              "nao_atendida"
            ],
            "default": "pendente"
          },
          "requer_devolutiva": {
            "type": "boolean",
            "default": true
          },
          "prazo_devolutiva": {
            "type": "string",
            "format": "date"
          },
          "devolutiva_realizada": {
            "type": "boolean",
            "default": false
          },
          "data_devolutiva": {
            "type": "string",
            "format": "date"
          },
          "devolutiva_status": {
            "type": "string",
            "enum": [
              "pendente",
              "realizada",
              "nao_realizada",
              "nao_se_aplica"
            ],
            "default": "pendente",
            "description": "Status do ciclo de devolutiva."
          },
          "devolutiva_data_prevista": {
            "type": "string",
            "format": "date"
          },
          "devolutiva_data_realizada": {
            "type": "string",
            "format": "date"
          },
          "devolutiva_responsavel": {
            "type": "string"
          },
          "devolutiva_forma": {
            "type": "string",
            "enum": [
              "reuniao",
              "visita",
              "telefone",
              "mensagem",
              "email",
              "oficio",
              "evento",
              "outra"
            ]
          },
          "devolutiva_resumo": {
            "type": "string"
          },
          "devolutiva_justificativa": {
            "type": "string"
          },
          "devolutiva_publico": {
            "type": "string"
          },
          "devolutiva_registro_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Demandas da comunidade"
    },
    "compromissos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "prazo": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "em_andamento",
              "concluido",
              "cancelado"
            ],
            "default": "pendente"
          }
        }
      },
      "description": "Compromissos assumidos"
    },
    "proximos_passos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pr\u00f3ximos passos identificados"
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "codigo_documento": {
            "type": "string"
          },
          "transcricao": {
            "type": "string"
          }
        }
      },
      "description": "Arquivos anexados"
    },
    "resumo_automatico": {
      "type": "string",
      "description": "Resumo gerado pela IA"
    },
    "ata_gerada": {
      "type": "string",
      "description": "Ata gerada pela IA"
    },
    "encaminhamento_realizado": {
      "type": "boolean",
      "default": false
    },
    "descricao_encaminhamento": {
      "type": "string"
    },
    "avaliacao_qualidade": {
      "type": "object",
      "properties": {
        "nota_final": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "nota_base": {
          "type": "number"
        },
        "forca_fonte": {
          "type": "string",
          "enum": [
            "forte",
            "intermediaria",
            "fraca"
          ]
        },
        "tipo_fonte": {
          "type": "string",
          "enum": [
            "documento_formal",
            "ata_reuniao",
            "relato_presencial",
            "fala_direta",
            "reuniao_online",
            "audio_contexto",
            "email_identificado",
            "whatsapp_grupo",
            "audio_sem_contexto",
            "relato_indireto"
          ]
        },
        "peso_fonte": {
          "type": "number"
        },
        "revisao_humana_certificada": {
          "type": "boolean",
          "default": false
        },
        "peso_revisao_humana": {
          "type": "number"
        },
        "criticidade_caso": {
          "type": "string",
          "enum": [
            "baixa",
            "media",
            "alta",
            "critica"
          ]
        },
        "revisor_nome": {
          "type": "string"
        },
        "revisor_email": {
          "type": "string"
        },
        "data_revisao": {
          "type": "string",
          "format": "date-time"
        },
        "justificativa_revisao": {
          "type": "string"
        },
        "componentes_nota": {
          "type": "object",
          "properties": {
            "clareza": {
              "type": "number"
            },
            "identificacao_territorial": {
              "type": "number"
            },
            "tipo_demanda": {
              "type": "number"
            },
            "encaminhamentos": {
              "type": "number"
            },
            "responsavel_identificado": {
              "type": "number"
            }
          }
        }
      }
    },
    "nota_qualidade": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "DEPRECATED - usar avaliacao_qualidade"
    },
    "validado_em": {
      "type": "string",
      "format": "date-time"
    },
    "observacao_validacao": {
      "type": "string"
    },
    "preenchimento_automatico": {
      "type": "object",
      "properties": {
        "origem": {
          "type": "string"
        },
        "campos_preenchidos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confianca": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "auditoria": {
      "type": "object",
      "properties": {
        "arquivos_originais": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transcricao_raw": {
          "type": "string"
        },
        "versao_estruturada": {
          "type": "object"
        },
        "insights_ia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materialidade_detectada": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "historico_alteracoes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "caso_relacionado": {
      "type": "string"
    },
    "registros_continuidade": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "demanda_relacionada": {
      "type": "object",
      "properties": {
        "registro_origem_id": {
          "type": "string"
        },
        "demanda_index": {
          "type": "number"
        },
        "descricao": {
          "type": "string"
        },
        "comunidade": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado",
        "arquivado"
      ],
      "default": "rascunho"
    },
    "status_sincronizacao": {
      "type": "string",
      "enum": [
        "sincronizando",
        "concluido",
        "erro",
        "pendente"
      ],
      "default": "concluido"
    },
    "liderancas_vinculadas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "organizacoes_vinculadas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agendas_geradas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "titulo"
  ]
}