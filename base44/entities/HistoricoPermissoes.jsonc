{
  "name": "HistoricoPermissoes",
  "type": "object",
  "properties": {
    "usuario_afetado_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que teve permiss\u00f5es alteradas"
    },
    "usuario_afetado_email": {
      "type": "string"
    },
    "usuario_afetado_nome": {
      "type": "string"
    },
    "usuario_responsavel_email": {
      "type": "string",
      "description": "Quem fez a altera\u00e7\u00e3o"
    },
    "usuario_responsavel_nome": {
      "type": "string"
    },
    "tipo_alteracao": {
      "type": "string",
      "enum": [
        "papel_adicionado",
        "papel_removido",
        "permissao_alterada",
        "role_criado",
        "role_atualizado",
        "usuario_desativado",
        "usuario_reativado"
      ]
    },
    "papel_nome": {
      "type": "string",
      "description": "Nome do papel afetado"
    },
    "detalhes_anterior": {
      "type": "object",
      "description": "Estado anterior das permiss\u00f5es"
    },
    "detalhes_novo": {
      "type": "object",
      "description": "Estado novo das permiss\u00f5es"
    },
    "justificativa": {
      "type": "string",
      "description": "Motivo da altera\u00e7\u00e3o"
    },
    "ip_origem": {
      "type": "string"
    }
  },
  "required": [
    "usuario_afetado_id",
    "tipo_alteracao"
  ]
}