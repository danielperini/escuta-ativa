{
  "name": "User",
  "type": "object",
  "properties": {
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o usu\u00e1rio est\u00e1 ativo no sistema"
    },
    "funcao": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o profissional do usu\u00e1rio (refer\u00eancia ao nome na entidade Funcao). Distinto do n\u00edvel de acesso (role)."
    },
    "papeis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos pap\u00e9is atribu\u00eddos ao usu\u00e1rio"
    },
    "configuracoes": {
      "type": "object",
      "properties": {
        "tema": {
          "type": "string",
          "enum": [
            "claro",
            "escuro"
          ],
          "default": "claro"
        },
        "prazo_devolutiva_dias": {
          "type": "number",
          "default": 15
        }
      }
    }
  },
  "required": [
    "papeis",
    "configuracoes"
  ]
}