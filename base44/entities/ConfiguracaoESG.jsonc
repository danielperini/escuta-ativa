{
  "name": "ConfiguracaoESG",
  "type": "object",
  "properties": {
    "nome_empresa": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "setor_atuacao": {
      "type": "string",
      "description": "Setor de atua\u00e7\u00e3o"
    },
    "territorios_influencia": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Territ\u00f3rios de influ\u00eancia"
    },
    "estrategia_esg": {
      "type": "string",
      "description": "Estrat\u00e9gia ESG declarada"
    },
    "compromissos_publicos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GRI",
          "Pacto Global",
          "ODS",
          "ISO 26000",
          "IFC Performance Standards",
          "Princ\u00edpios do Equador",
          "AA1000",
          "Direitos Humanos / UNGP",
          "Outro",
          "CSRD",
          "B Corp"
        ]
      },
      "description": "Referenciais e Compromissos ESG adotados. CSRD e B Corp mantidos apenas para legado hist\u00f3rico."
    },
    "referenciais_prioritarios": {
      "type": "object",
      "properties": {
        "gri_standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gri_detalhamento": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GRI 2-29",
              "GRI 413"
            ]
          },
          "description": "Detalhamento interno do GRI (n\u00e3o compromisso independente). Extens\u00edvel para futuros padr\u00f5es."
        },
        "ods_prioritarios": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 17
          }
        },
        "esrs_aplicaveis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ESRS (legado CSRD). N\u00e3o oferecido para novos cadastros."
        }
      },
      "description": "Referenciais priorit\u00e1rios e detalhamentos"
    },
    "contato_responsavel": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "telefone": {
          "type": "string"
        }
      }
    },
    "metodologia_classificacao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da metodologia de classifica\u00e7\u00e3o"
    },
    "logo_empresa_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    }
  },
  "required": [
    "nome_empresa"
  ]
}